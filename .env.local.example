# Copy to .env.local and fill in.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Optional overrides
CLAUDE_MODEL=claude-opus-5
ELEVENLABS_MODEL=eleven_multilingual_v2
# pcm_24000 works on every ElevenLabs tier; pcm_44100 needs Pro.
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_CONCURRENCY=4

# DRY_RUN=1 returns placeholder text/audio/images so you can click through the UI for free.
DRY_RUN=0
